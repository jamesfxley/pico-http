# Generated by dev.py sync.
# House clang-tidy configuration.
#
# POSTURE: every check is on, and the exclusions are enumerated with a reason.
# This is the inverse of the common `-*` plus a handful of families, which
# silently omits everything nobody thought to enable -- and that is most of what
# clang-tidy knows. Findings are errors: a green build with findings is a failed
# build.
#
# PINNED TO clang-tidy 20 (see .clang-version). Two things below are
# version-specific and must be re-derived on a version bump:
#   - the alias list: alias direction changes between releases. In 18
#     `bugprone-narrowing-conversions` aliased the cppcoreguidelines check; in
#     20 it is the other way round.
#   - `ExcludeHeaderFilterRegex`, which requires clang-tidy 19 or newer.
#
# TRAP: `Checks:` below is a YAML folded scalar. A `#` inside it is NOT a
# comment -- it is folded into the string and parsed as a check glob, and a
# fragment that ends up without a comma before it silently swallows the next
# entry. That is why every reason lives here, above the block, and the block
# itself contains nothing but globs. After editing, verify with:
#     clang-tidy --dump-config | head -2
# and confirm the Checks string contains no prose.
#
# Suppressing a check for a whole directory is NOT done by adding a .clang-tidy
# below the root. That is a standing deviation: register it in
# docs/deviations.md with a rationale, a risk assessment and a review date, then
# implement it. The deviations gate counts suppressions against the ceiling;
# review checks the register (EN-00.5).
#
# ---------------------------------------------------------------------------
# SECTION 1 -- families for platforms and libraries this project does not use.
# Not judgements about the checks; they simply cannot apply here.
#
#   abseil, altera, android, boost, darwin, fuchsia, linuxkernel, llvm,
#   llvmlibc, mpi, objc, openmp, zircon
#
# `google-*` is deliberately kept: it is the basis of this project's formatting
# and carries real checks (explicit constructors, fixed-width integer types).
#
# ---------------------------------------------------------------------------
# SECTION 2 -- aliases.
#
# Each disabled name in section 2 of the block below is a second name for a
# check that stays enabled under its canonical name. Enabling both reports every
# finding twice. The list is derived from the clang-tidy 20 alias table and
# verified against the binary: every pair exists in this version, and every
# canonical target is enabled.
#
# One documented exception. `google-readability-namespace-comments` is an alias
# of `llvm-namespace-comment`, but llvm-* is excluded by section 1, so disabling
# the alias too would lose the check entirely. It is therefore left enabled.
#
# ---------------------------------------------------------------------------
# SECTION 3 -- individually disabled, each for a stated reason.
#
# This is the list to be suspicious of. Every entry claims the project will not
# follow a rule *anywhere*, which is a stronger claim than a per-directory
# disable -- which is precisely why it lives in the shared, reviewed
# configuration rather than scattered in subdirectories. Keep it short; prefer
# tuning a check through CheckOptions.
#
# EN-00.7: each entry carries a review date. A disable with no date is unbounded
# in time, and the argument EN-00.5 makes for the narrower case holds more
# strongly here, not less. The date does not turn the check back on -- it
# requires the claim to be made again.
#
#   modernize-use-trailing-return-type
#       Prescribes a trailing return type on every function. A pure style
#       preference, and the opposite of the style this project's formatting is
#       based on. Nothing is caught by it.
#       Review by 2027-05-13.
#
#   bugprone-easily-swappable-parameters
#       Fires on every function taking two parameters of the same type, which
#       is most well-typed interfaces (a begin/end pair, a width/height). The
#       remedy -- a distinct wrapper type per parameter -- is occasionally
#       right and usually noise; where it is right, CXX-04 already calls for it.
#       Review by 2027-05-13.
#
#   google-readability-todo
#       Demands a username in every TODO. Version control already records who
#       wrote the line, more reliably.
#       Review by 2027-05-13.
#
#   cppcoreguidelines-pro-bounds-constant-array-index
#       The prescribed remedy is `gsl::at`, which reports a bounds failure by
#       throwing. A project that builds without exceptions cannot adopt it, and
#       vendoring GSL to satisfy one check is not proportionate. Bounds safety
#       on fixed-capacity storage is instead required by CXX-06 -- every
#       subscript is reached only past an explicit capacity guard -- and is a
#       review-only rule on the C++ review checklist rather than an unchecked
#       one.
#       Review by 2027-05-13.
# ---------------------------------------------------------------------------

Checks: >
  *,
  -abseil-*,
  -altera-*,
  -android-*,
  -boost-*,
  -darwin-*,
  -fuchsia-*,
  -linuxkernel-*,
  -llvm-*,
  -llvmlibc-*,
  -mpi-*,
  -objc-*,
  -openmp-*,
  -zircon-*,
  -cert-arr39-c,
  -cert-con36-c,
  -cert-con54-cpp,
  -cert-ctr56-cpp,
  -cert-dcl03-c,
  -cert-dcl16-c,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-dcl54-cpp,
  -cert-dcl59-cpp,
  -cert-err09-cpp,
  -cert-err61-cpp,
  -cert-exp42-c,
  -cert-fio38-c,
  -cert-flp37-c,
  -cert-int09-c,
  -cert-msc24-c,
  -cert-msc30-c,
  -cert-msc32-c,
  -cert-msc33-c,
  -cert-msc54-cpp,
  -cert-oop11-cpp,
  -cert-oop54-cpp,
  -cert-pos44-c,
  -cert-pos47-c,
  -cert-sig30-c,
  -cert-str34-c,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-c-copy-assignment-signature,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-noexcept-destructor,
  -cppcoreguidelines-noexcept-move-operations,
  -cppcoreguidelines-noexcept-swap,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-use-default-member-init,
  -fuchsia-header-anon-namespaces,
  -google-readability-braces-around-statements,
  -google-readability-function-size,
  -hicpp-avoid-c-arrays,
  -hicpp-avoid-goto,
  -hicpp-braces-around-statements,
  -hicpp-deprecated-headers,
  -hicpp-explicit-conversions,
  -hicpp-function-size,
  -hicpp-invalid-access-moved,
  -hicpp-member-init,
  -hicpp-move-const-arg,
  -hicpp-named-parameter,
  -hicpp-new-delete-operators,
  -hicpp-no-array-decay,
  -hicpp-no-malloc,
  -hicpp-noexcept-move,
  -hicpp-special-member-functions,
  -hicpp-static-assert,
  -hicpp-undelegated-constructor,
  -hicpp-uppercase-literal-suffix,
  -hicpp-use-auto,
  -hicpp-use-emplace,
  -hicpp-use-equals-default,
  -hicpp-use-equals-delete,
  -hicpp-use-noexcept,
  -hicpp-use-nullptr,
  -hicpp-use-override,
  -hicpp-vararg,
  -llvm-else-after-return,
  -llvm-qualified-auto,
  -modernize-use-trailing-return-type,
  -bugprone-easily-swappable-parameters,
  -google-readability-todo,
  -cppcoreguidelines-pro-bounds-constant-array-index

WarningsAsErrors: '*'

# Diagnose our own headers, not our dependencies'. The exclusion needs
# clang-tidy 19+; on an older pin, narrow HeaderFilterRegex instead.
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*/(_deps|build[^/]*|third_party|external|\.cache)/.*'

FormatStyle: file

CheckOptions:
  # --- Identifier naming ---
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.ConceptCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE

  # ConstantCase is the fallback for every kind of constant, including a
  # const-qualified local. UPPER_CASE describes a constant of the program, not a
  # local that happens not to be reassigned -- naming a table lookup LENGTH says
  # something untrue about it, and the alternative the rule pushes people to is
  # dropping the const. Locals keep lower_case.
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.LocalConstantPointerCase
    value: lower_case

  # LocalConstant covers every local constant, so on its own it also demoted
  # local `constexpr` -- a genuine compile-time constant of the program, which
  # the rule above is not about. ConstexprVariable is the more specific option
  # and wins wherever both apply, so `constexpr std::size_t LIMIT = 8;` stays
  # UPPER_CASE while `const std::size_t scaled = n * 2;` is lower_case.
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE

  # --- Size and complexity ---
  - key: readability-function-size.LineThreshold
    value: 100
  - key: readability-function-size.ParameterThreshold
    value: 6
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true

  # --- Literals ---
  # Small values and powers of two are structural, not magic: a shift width, a
  # doubling, a half. Everything else earns a name.
  - key: readability-magic-numbers.IgnoredIntegerValues
    value: '0;1;2;3;4;8;16;32;64;'
  - key: readability-magic-numbers.IgnorePowersOf2IntegerValues
    value: true

  # --- Identifier length ---
  # The default minimum of 3 rejects the conventional loop and coordinate
  # names, which are clearer short than padded out.
  - key: readability-identifier-length.MinimumVariableNameLength
    value: 2
  - key: readability-identifier-length.MinimumParameterNameLength
    value: 2
  - key: readability-identifier-length.IgnoredVariableNames
    value: '^(i|j|k|n|x|y|z|it|id|os|is|lo|hi)$'
  - key: readability-identifier-length.IgnoredParameterNames
    value: '^(i|j|k|n|x|y|z|it|id|os|is|lo|hi)$'

  # --- Structural ---
  # A struct that is all-public data is an aggregate, which is a legitimate
  # design and not an under-encapsulated class.
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true
  # do/while inside a macro is the standard way to make it statement-safe.
  - key: cppcoreguidelines-avoid-do-while.IgnoreMacros
    value: true
